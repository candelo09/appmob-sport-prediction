{
  "expo": {
    "name": "mbsport-prediction",
    "slug": "mbsport-prediction",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logochjbet.png",
    "scheme": "mbsportprediction",
    "userInterfaceStyle": "automatic",
    // "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logochjbet.png"
        //"backgroundImage": "./assets/images/android-icon-background.png",
        //"monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      // "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.candelo09.mbsportprediction"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logochjbet.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c42a860-af3b-4836-8701-6c789319f851"
      }
    }
  }
}
